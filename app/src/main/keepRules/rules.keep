# R8 rules for release builds (AGP combines every file in src/main/keepRules).
# R8 shrinks, optimizes and renames classes/members; these rules only add to its defaults.
# See https://d.android.com/r/tools/r8/keep-rules

# ---- Obfuscation ---------------------------------------------------------------------------
# Move every renamed class into the root package so package names (auth, ui, data…) don't leak
# the app's structure.
-repackageclasses ''
-allowaccessmodification

# Drop file names from stack traces; keep line numbers so crashes can be retraced with the
# mapping file (build/outputs/mapping/release/mapping.txt — archive it with every release).
-renamesourcefileattribute SourceFile
-keepattributes SourceFile,LineNumberTable

# ---- Logging -------------------------------------------------------------------------------
# Strip verbose/debug/info/warning logs from release builds; they describe the login flow
# (redirects, server responses). Errors are kept for crash diagnosis.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
    public static int w(...);
}

# ---- Keeps ---------------------------------------------------------------------------------
# Nothing in the app is reached by reflection or serialization: auth parses JSON by hand with
# org.json, and the SSO WebView only calls evaluateJavascript (no @JavascriptInterface), so no
# app classes need to be kept. If you add a JavaScript interface, keep it like this:
#-keepclassmembers class com.example.sclerago.SomeJsBridge {
#   @android.webkit.JavascriptInterface <methods>;
#}
