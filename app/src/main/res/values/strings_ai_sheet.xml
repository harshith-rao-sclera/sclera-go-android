<?xml version="1.0" encoding="utf-8"?>
<!-- The AI suggestions sheet, as the iOS app's. English only for now. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="ai_sheet_subtitle">Suggests %1$s’s type and field values from the model’s published specifications; you choose what to keep. Nothing is saved until you apply and save.</string>
    <string name="ai_step_photos">Reading the photos</string>
    <string name="ai_photo_differs">The photo shows something else than the form has: %1$s</string>
    <string name="ai_from_photo">From the photo</string>
    <string name="ai_photo_note_name">%1$s:</string>
    <string name="ai_sum_nothing">Nothing to fill.</string>
    <string name="ai_apply">Apply</string>
    <plurals name="ai_sum_read">
        <item quantity="one">Read %1$d field.</item>
        <item quantity="other">Read %1$d fields.</item>
    </plurals>
    <plurals name="ai_sum_differ">
        <item quantity="one">%1$d different from saved. Check it.</item>
        <item quantity="other">%1$d different from saved. Check them.</item>
    </plurals>
    <plurals name="ai_sum_fill">
        <item quantity="one">%1$d field to fill.</item>
        <item quantity="other">%1$d fields to fill.</item>
    </plurals>
    <!-- A new asset opened from a scanned device with a model: the form is filled from what the scan found. -->
    <string name="ai_scan_reading">Looking up what the scan found to fill the form…</string>
    <string name="ai_scan_failed">The AI couldn’t look up what the scan found: %1$s</string>
    <string name="ai_scan_nothing">The AI looked up what the scan found but found nothing new to fill.</string>
    <string name="ai_manuals_title">Manuals for this model</string>
    <!-- The property's AI switch is off (Configuration → Settings → AI): every AI button stays, disabled, with this; the
         server's refusal of anything AI says the same. -->
    <string name="ai_off">AI off. An admin can turn it on.</string>
</resources>
