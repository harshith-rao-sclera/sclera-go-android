<?xml version="1.0" encoding="utf-8"?>
<!-- Asset details → Info → Assignment: who has the asset, and who submitted it and when. Assign asset sheet. English only for now. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="detail_sec_assignment">Assignment</string>
    <string name="detail_assigned_to">Assigned to</string>
    <string name="detail_submitted_by">Submitted by</string>
    <string name="detail_submitted_on">Submitted on</string>
    <string name="detail_unassigned">Not assigned</string>
    <string name="detail_person_unknown">Unknown user</string>

    <!-- Assign asset sheet, worded as the web's assign modal. -->
    <string name="assign_assignee">Assignee</string>
    <string name="assign_apply">Apply</string>
    <string name="assign_nobody">Nobody (unassigned)</string>
    <!-- %1$s: the signed-in user's email. -->
    <string name="assign_to_me">Assign to me (%1$s)</string>
    <string name="assign_admin_only">Only a reviewer can assign assets to someone.</string>
    <plurals name="assign_done_nobody">
        <item quantity="one">%1$d asset unassigned</item>
        <item quantity="other">%1$d assets unassigned</item>
    </plurals>
    <plurals name="assign_not_found">
        <item quantity="one">%1$d asset isn’t on the server yet, so it was left as it was. Assign it again after it syncs.</item>
        <item quantity="other">%1$d assets aren’t on the server yet, so they were left as they were. Assign them again after they sync.</item>
    </plurals>
    <!-- %1$s: what was assigned ("3 assets assigned to Ada"); %2$s: the assets the server doesn't have yet. -->
    <string name="assign_done_and_not_found">%1$s. %2$s</string>

    <!-- "Assign to me": someone who isn't an admin takes assets assigned to nobody, worded as the web's. -->
    <string name="action_assign_to_me">Assign to me</string>
    <string name="assign_taking">Assigning…</string>
    <plurals name="assign_taken">
        <item quantity="one">%1$d asset assigned to you</item>
        <item quantity="other">%1$d assets assigned to you</item>
    </plurals>
    <string name="assign_take_failed">Couldn’t assign the assets to you.</string>
    <!-- Assign sheet: the organisation's people couldn't be read (shown in place of the list). -->
    <string name="assign_load_failed">Couldn’t load the people you can assign to.</string>
    <string name="assign_take_refused">Only a reviewer can change who an asset is assigned to.</string>
    <string name="assign_take_assigned">Already assigned. Only a reviewer can reassign it</string>
    <string name="assign_take_some_assigned">Some are already assigned. Only a reviewer can reassign assets</string>
    <string name="assign_take_yours">Already assigned to you</string>
    <string name="assign_take_some_yours">Some are already assigned to you</string>
    <string name="assign_take_submitted">Submitted. Only a reviewer can assign it</string>
    <string name="assign_take_some_submitted">Some are submitted. Only a reviewer can assign them</string>
</resources>
