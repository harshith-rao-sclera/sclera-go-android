<resources>
    <style name="Theme.ScleraGo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sclera_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      System splash (Android can't skip it from 12 on): only the dark canvas, the same colour as the
      first frame of the Compose launch animation, so the animation seems to start straight away.
    -->
    <style name="Theme.Sclera.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sclera_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.ScleraGo</item>
    </style>
</resources>
