<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / device-transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The Sclera session id and access token must never leave the device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="sclera_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sclera_auth.xml" />
    </device-transfer>
</data-extraction-rules>
